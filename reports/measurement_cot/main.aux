\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The Jensen gap between evolving the averaged state and averaging the evolved states, computed exactly over the candidate set. \textbf  {(a)} the predicted $\beta ^{2}$ law of Proposition~\ref {prop:second-order}. \textbf  {(b)} tempering the chain's own scores sweeps the candidate spread across its full range; the gap falls steeply towards zero as $p$ sharpens, in the direction Corollary~\ref {cor:confidence} requires, and the shaded band marks where the trained chain's own steps actually sit. \textbf  {(c)} bucketing those steps by entropy instead gives a flat line --- not a refutation, but a range problem, since the spread is saturated everywhere in (b)'s shaded band.}}{12}{figure.caption.17}\protected@file@percent }
\newlabel{fig:jensen}{{5}{12}{The Jensen gap between evolving the averaged state and averaging the evolved states, computed exactly over the candidate set. \textbf {(a)} the predicted $\beta ^{2}$ law of Proposition~\ref {prop:second-order}. \textbf {(b)} tempering the chain's own scores sweeps the candidate spread across its full range; the gap falls steeply towards zero as $p$ sharpens, in the direction Corollary~\ref {cor:confidence} requires, and the shaded band marks where the trained chain's own steps actually sit. \textbf {(c)} bucketing those steps by entropy instead gives a flat line --- not a refutation, but a range problem, since the spread is saturated everywhere in (b)'s shaded band}{figure.caption.17}{}}
